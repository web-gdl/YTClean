<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.YTClean" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/fg</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>
    <style name="Theme.YTClean.Player" parent="Theme.YTClean">
        <item name="android:statusBarColor">@android:color/black</item>
    </style>
    <!-- Acción del reproductor: icono encima y texto corto, ancho repartido. -->
    <style name="Widget.YTClean.PlayerAction" parent="Widget.Material3.Button.TextButton.Icon">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">64dp</item>
        <item name="android:paddingStart">2dp</item>
        <item name="android:paddingEnd">2dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/action_fg</item>
        <item name="iconGravity">top</item>
        <item name="iconPadding">4dp</item>
        <item name="iconSize">24dp</item>
        <item name="iconTint">@color/action_fg</item>
        <item name="shapeAppearance">?attr/shapeAppearanceCornerMedium</item>
    </style>
</resources>
