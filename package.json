{
  "name": "youtube-clean",
  "version": "0.2.0",
  "private": true,
  "description": "Interfaz web privada y minimalista para buscar y reproducir vídeos públicos de YouTube: sin anuncios propios, sin rastreo propio y sin cuentas.",
  "type": "module",
  "license": "Unlicense",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:connections": "node scripts/check-connections.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:connections",
    "e2e": "playwright test",
    "local": "node local/server.mjs",
    "local:dev": "node local/server.mjs --dev-origin http://127.0.0.1:5173",
    "local:android": "node local/server.mjs --dev-origin http://localhost",
    "build:android": "YC_CSP_CONNECT=\"https: http://127.0.0.1:8787\" YC_CSP_IMG=\"https: http://127.0.0.1:8787\" YC_CSP_MEDIA=\"http://127.0.0.1:8787\" YC_CSP_NO_UPGRADE=1 VITE_DEFAULT_LOCAL_URL=http://127.0.0.1:8787 npm run build && npx cap sync android",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
